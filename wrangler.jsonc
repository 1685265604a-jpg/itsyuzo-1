{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-photo-archive",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/assets/photos/IMG_6093.JPG"]
  },
  "durable_objects": { "bindings": [{ "name": "GALLERY_STATE", "class_name": "GalleryState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GalleryState"] }],
  "r2_buckets": [{ "binding": "ORIGINALS", "bucket_name": "my-photo-archive-originals" }],
  "observability": { "enabled": true }
}
